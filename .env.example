# Apple username only. Never place the password or 2FA code here.
ICLOUD_USERNAME=
ICLOUD_CHINA_MAINLAND=false
ICLOUD_SESSION_DIR=state/pyicloud-session
DEFAULT_TIMEZONE=Europe/Zurich
DEFAULT_REMINDER_LIST=
ALLOWED_REMINDER_LISTS=
WRITABLE_REMINDER_LISTS=
WRITE_ACTIONS_ENABLED=true
DELETE_ACTIONS_ENABLED=true
CONFIRMATION_SIGNING_SECRET=
CONFIRMATION_TTL_SECONDS=300
READ_RATE_LIMIT_PER_MINUTE=120
WRITE_RATE_LIMIT_PER_MINUTE=30
MAX_REMINDERS_PER_REQUEST=200
MCP_HOST=127.0.0.1
MCP_PORT=13003
MCP_PATH=/mcp
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
TUNNEL_PROFILE=apple-reminders-mcp
TUNNEL_HEALTH_LISTEN_ADDR=127.0.0.1:0
TUNNEL_CLIENT_BIN=
RUN_ICLOUD_INTEGRATION_TESTS=false
ICLOUD_TEST_REMINDER_LIST_ID=

